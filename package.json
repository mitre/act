{
  "name": "nuxt-ui-pro-template-saas",
  "private": true,
  "type": "module",
  "pnpm": {
    "neverBuiltDependencies": [],
    "overrides": {
      "unimport": "4.1.1",
      "vue-tsc": "2.2.10",
      "tar-fs@>=2.0.0 <2.1.4": ">=2.1.4",
      "tar-fs@>=3.0.0 <3.1.1": ">=3.1.1",
      "vite@>=7.1.0 <=7.1.10": ">=7.1.11"
    }
  },
  "trustedDependencies": [
    "simple-git-hooks",
    "@tailwindcss/oxide"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:log": "nuxt dev 2>&1 | tee logs/dev-$(date +%Y%m%d-%H%M%S).log",
    "dev:clean": "nuxt dev --clean-cache",
    "dev:clean-log": "nuxt dev --clean-cache 2>&1 | tee logs/dev-clean-$(date +%Y%m%d-%H%M%S).log",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "logs:clear": "rm -rf logs/*.log || true",
    "logs:dir": "mkdir -p logs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ],
    "pnpm-lock.yaml": [
      "git restore --staged"
    ]
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.70",
    "@iconify-json/simple-icons": "^1.2.55",
    "@mitre/nuxt-smartscript": "^0.4.1",
    "@nuxt/content": "^3.7.1",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.10.0",
    "@nuxt/ui": "^4.0.1",
    "@standard-schema/spec": "^1.0.0",
    "@vueuse/nuxt": "^13.9.0",
    "defu": "^6.1.4",
    "nuxt": "^4.1.3",
    "nuxt-github-pages": "^1.0.0",
    "nuxt-og-image": "^5.1.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.32",
    "@nuxt/eslint": "^1.4.1",
    "better-sqlite3": "12.4.1",
    "eslint": "^9.38.0",
    "lint-staged": "^16.2.5",
    "prettier": "^3.5.3",
    "sharp": "^0.34.4",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^5.9.3",
    "vue-tsc": "2.2.10"
  },
  "resolutions": {
    "unimport": "4.1.1",
    "vue-tsc": "2.2.10"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
