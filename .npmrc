# pnpm configuration for MITRE ACT project
# Required for proper handling of native modules on all platforms

# Allow proper handling of native module dependencies
shamefully-hoist=true

# Specific package hoisting patterns for native modules
public-hoist-pattern[]=*sharp*
public-hoist-pattern[]=*better-sqlite3*
public-hoist-pattern[]=*parcel*
public-hoist-pattern[]=*vue*

# Native dependencies are handled via hoisting patterns above

# Allow build scripts for ALL packages (required for native dependencies)
# Without this, better-sqlite3, sharp, etc. won't build on Netlify
ignore-scripts=false

# Auto-approve build scripts for trusted packages
# This prevents "Ignored build scripts" blocking native module builds
package-import-method=hardlink
