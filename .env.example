# Cloudflare Pages deployment
# Account ID is not a secret — it identifies the Cloudflare account
CLOUDFLARE_ACCOUNT_ID=0df2a401a04f11bf57c658ada2679b4b
# API token IS a secret — get one at https://dash.cloudflare.com/profile/api-tokens
# Needs "Cloudflare Pages: Edit" permission
CLOUDFLARE_API_TOKEN=
